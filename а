(() => {
  'use strict';

  let currentLang = 'en';

  function applyLanguage(lang) {
    const dict = (typeof CONTENT !== 'undefined' && CONTENT[lang]) || (typeof CONTENT !== 'undefined' && CONTENT.en);
    if (!dict) return;
    currentLang = lang;
    document.documentElement.lang = lang === 'sr' ? 'sr-Latn' : lang;

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.dataset.i18n;
      if (dict[key] != null) el.textContent = dict[key];
    });
    document.querySelectorAll('[data-i18n-alt]').forEach((el) => {
      const key = el.dataset.i18nAlt;
      if (dict.alts && dict.alts[key]) el.setAttribute('alt', dict.alts[key].title || '');
    });
    document.querySelectorAll('.lang-btn').forEach((b) => {
      b.classList.toggle('is-active', b.dataset.lang === lang);
    });

    refreshPlaques();
    if (lightbox.classList.contains('is-open') && currentLightboxItem) {
      lightboxCaption.textContent = buildCaption(currentLightboxItem);
    }
    try { localStorage.setItem('lang', lang); } catch (e) { /* ignore */ }
  }
  document.querySelectorAll('.lang-btn').forEach((btn) => {
    btn.addEventListener('click', () => applyLanguage(btn.dataset.lang));
  });

  const items = Array.from(document.querySelectorAll('.wall-item'));

  function buildCaption(item) {
    const dict = (typeof CONTENT !== 'undefined' && CONTENT[currentLang]) || {};
    const chapter = dict[item.dataset.chapterKey] || '';
    const alt = (dict.alts && dict.alts[item.dataset.altKey] && dict.alts[item.dataset.altKey].title) || '';
    return chapter && alt ? `${chapter} - ${alt}` : (chapter || alt);
  }
  function refreshPlaques() {
    const dict = (typeof CONTENT !== 'undefined' && CONTENT[currentLang]) || {};
    items.forEach((item) => {
      const titleEl = item.querySelector('.plaque-title');
      const specsEl = item.querySelector('.plaque-specs');
      if (titleEl) titleEl.textContent = buildCaption(item);
      if (specsEl) {
        const entry = dict.alts && dict.alts[item.dataset.altKey];
        const specs = (entry && entry.specs) || '';
        specsEl.textContent = specs;
        specsEl.style.display = specs ? '' : 'none';
      }
    });
  }

  const track = document.getElementById('wallTrack');

  let velocity = 0;
  let rafId = null;

  function momentumStep() {
    track.scrollLeft += velocity;
    velocity *= 0.92;
    if (Math.abs(velocity) > 0.4) {
      rafId = requestAnimationFrame(momentumStep);
    } else {
      velocity = 0;
      rafId = null;
    }
  }
  function kick(v) {
    velocity += v;
    if (!rafId) rafId = requestAnimationFrame(momentumStep);
  }

  track.addEventListener('wheel', (e) => {
    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
      kick(e.deltaY * 0.45);
      e.preventDefault();
    }
  }, { passive: false });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') kick(320);
    if (e.key === 'ArrowLeft') kick(-320);
  });

  let dragging = false, dragStartX = 0, dragStartScroll = 0, dragMoved = 0;
  let lastX = 0, lastT = 0, releaseVelocity = 0;
  let downTarget = null;

  track.addEventListener('pointerdown', (e) => {
    if (e.target.closest('a') || e.target.closest('button')) return;
    
    dragging = true;
    dragMoved = 0;
    downTarget = e.target;
    velocity = 0;
    if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
    dragStartX = e.clientX;
    dragStartScroll = track.scrollLeft;
    lastX = e.clientX;
    lastT = performance.now();
    releaseVelocity = 0;
  });

  track.addEventListener('pointermove', (e) => {
    if (!dragging) return;
    const dx = e.clientX - dragStartX;
    dragMoved = Math.max(dragMoved, Math.abs(dx));

    // Включаем захват pointerCapture только при фактическом драге (> 4px)
    if (dragMoved > 4 && !track.hasPointerCapture(e.pointerId)) {
      track.classList.add('is-grabbing');
      try { track.setPointerCapture(e.pointerId); } catch (err) {}
    }

    if (dragMoved > 4) {
      track.scrollLeft = dragStartScroll - dx;
    }

    const now = performance.now();
    const dt = now - lastT;
    if (dt > 0) releaseVelocity = -((e.clientX - lastX) / dt) * 16;
    lastX = e.clientX;
    lastT = now;
  });

  function endDrag(e) {
    if (!dragging) return;
    dragging = false;
    track.classList.remove('is-grabbing');
    if (e && e.pointerId && track.hasPointerCapture(e.pointerId)) {
      try { track.releasePointerCapture(e.pointerId); } catch (err) {}
    }
    if (Math.abs(releaseVelocity) > 0.4) kick(releaseVelocity);
  }
  track.addEventListener('pointerup', endDrag);
  track.addEventListener('pointercancel', endDrag);

  track.addEventListener('click', (e) => {
    if (dragMoved > 8) return;
    
    const target = downTarget || e.target;
    const item = target.closest('.wall-item') || (e.target !== track ? e.target.closest('.wall-item') : null);
    
    if (item) {
      openLightbox(item);
    }
  });

  const cols = Array.from(document.querySelectorAll('.wall-col'));
  if ('IntersectionObserver' in window) {
    const spotObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('in-view', entry.isIntersecting);
      });
    }, { root: track, threshold: 0.15 });

    cols.forEach((col) => spotObserver.observe(col));
  } else {
    cols.forEach((col) => col.classList.add('in-view'));
  }

  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightboxImg');
  const lightboxCaption = document.getElementById('lightboxCaption');
  const lightboxClose = document.getElementById('lightboxClose');
  let currentLightboxItem = null;

  function openLightbox(item) {
    const img = item.querySelector('img');
    if (!img) return;
    currentLightboxItem = item;
    lightboxImg.src = img.src;
    lightboxCaption.textContent = buildCaption(item);
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
  }
  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    setTimeout(() => { if (!lightbox.classList.contains('is-open')) lightboxImg.src = ''; }, 400);
    currentLightboxItem = null;
  }
  lightboxClose.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox.classList.contains('is-open')) closeLightbox();
  });

  try {
    const saved = localStorage.getItem('lang');
    if (saved && (saved === 'ru' || saved === 'en' || saved === 'sr')) applyLanguage(saved);
    else applyLanguage(navigator.language.startsWith('ru') ? 'ru' : (navigator.language.startsWith('sr') ? 'sr' : 'en'));
  } catch (e) { applyLanguage('en'); }

})();





portfolio/desktop/styles.css
:root{
  --ink: #efe6d6;
  --muted: rgba(239,230,214,0.6);
  --line: rgba(239,230,214,0.16);
  --wood-lo: #140d08;
  --wood-hi: #3e2a19;
  --gold: #a9895a;
  --mat: #ece2ce;

  --font-display: 'Playfair Display', Georgia, serif;
  --font-ui: 'PT Sans', -apple-system, sans-serif;
}

*{ box-sizing: border-box; }

html, body{
  margin: 0;
  height: 100%;
  background: #0a0a0a;
  color: var(--ink);
  font-family: var(--font-ui);
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
  user-select: none;
}

img{ max-width: none; display: block; }

/* --- HEADER (ПОТОЛОК) --- */
.header-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 90px;
  background: linear-gradient(to bottom, #16110d, #0d0907);
  border-bottom: 2px solid #000;
  box-shadow: 0 10px 30px rgba(0,0,0,0.9);
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40px;
}
.header-bar::after {
  content: ''; position: absolute; inset: 0;
  background: url('../images/grain.png');
  opacity: 0.15;
  pointer-events: none;
}

.lang-switch { position: relative; display: flex; gap: 8px; z-index: 2; }
.lang-btn {
  background: none; border: 1px solid var(--line); color: var(--muted);
  font-family: var(--font-ui); font-size: .8rem; padding: 6px 13px;
  border-radius: 20px; cursor: pointer; transition: color .2s, border-color .2s;
}
.lang-btn.is-active, .lang-btn:hover { color: var(--ink); border-color: var(--ink); }

.identity { position: relative; z-index: 2; text-align: center; pointer-events: none; }
.identity .name { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; margin: 0; }
.identity .line { font-family: var(--font-display); font-style: italic; font-size: 0.95rem; color: var(--muted); margin: 6px 0 0; }

.social-bar { position: relative; display: flex; gap: 18px; z-index: 2; }
.social-bar a {
  display: flex; align-items: center; justify-content: center; width: 24px; height: 24px;
  color: var(--ink); opacity: .78; transition: opacity .2s, transform .2s;
}
.social-bar a:hover { opacity: 1; transform: translateY(-1px); }
.social-bar svg { width: 100%; height: 100%; display: block; }

/* --- FOOTER (ПОЛ) --- */
.footer-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  height: 30px;
  background: linear-gradient(to top, #16110d, #0d0907);
  border-top: 2px solid #000;
  box-shadow: 0 -10px 30px rgba(0,0,0,0.9);
  z-index: 40;
}
.footer-bar::after {
  content: ''; position: absolute; inset: 0;
  background: url('../images/grain.png');
  opacity: 0.15;
  pointer-events: none;
}

/* --- СТЕНА И ГАЛЕРЕЯ --- */
.wall-track {
  position: fixed;
  top: 90px; bottom: 30px; left: 0; right: 0;
  overflow-x: auto; overflow-y: hidden;
  scrollbar-width: none;
  cursor: grab;
  z-index: 2;
}
.wall-track::-webkit-scrollbar{ display: none; }
.wall-track.is-grabbing{ cursor: grabbing; }

/* Фиксированный шум поверх всей стены (без швов тайлинга) */
.wall-track::before {
  content: '';
  position: fixed;
  inset: 0;
  background: url('../images/grain.png');
  opacity: 0.12;
  pointer-events: none;
  z-index: 1;
}

.wall-surface {
  position: relative;
  height: 100%;
  min-width: 100%;
  display: flex;
  align-items: stretch;
  padding: 0 5vw;
  background: linear-gradient(to bottom, #1f1f1f 0%, #141414 50%, #0d0d0d 100%);
  box-shadow: inset 0 25px 40px -15px rgba(0,0,0,0.8);
}
.wall-baseboard {
  position: absolute;
  bottom: 0; left: 0; right: 0; height: 16px;
  background: #080808;
  border-top: 2px solid #222;
  z-index: 0;
}

.wall-col {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex: 0 0 auto;
  width: max-content;
  min-width: max-content;
  padding: 0 clamp(60px, 5vw, 110px);
}
.wall-col:nth-child(2n) { padding-inline: clamp(75px, 6vw, 130px); }
.wall-col:nth-child(3n) { padding-inline: clamp(50px, 4vw, 95px); }
.wall-col.stack { gap: clamp(20px, 3vh, 35px); }

/* --- ОСВЕЩЕНИЕ --- */
.lamp {
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 44px; height: 12px;
  background: #111;
  border-radius: 0 0 4px 4px;
  border: 1px solid #333;
  border-top: none;
  z-index: 10;
}
.lamp::after {
  content: ''; position: absolute;
  bottom: 0; left: 8px; right: 8px; height: 3px;
  background: #ffe3b3; border-radius: 50%;
  box-shadow: 0 1px 8px #ffe3b3;
}
.spot {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: radial-gradient(ellipse 120% 80% at 50% 0%, rgba(255, 235, 195, 0.12) 0%, rgba(255, 235, 195, 0.03) 60%, transparent 100%);
  pointer-events: none;
  opacity: 1;
  z-index: 1;
}

/* --- КАРТИНЫ И РАМКИ --- */
.wall-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(var(--dy, 0px));
  margin: 0;
  padding-top: 55px;
  cursor: pointer;
}

.frame {
  position: relative;
  z-index: 2;
  border-radius: 2px;
  padding: 12px;
  background: linear-gradient(150deg, var(--wood-hi) 0%, var(--wood-lo) 55%, #0c0805 100%);
  box-shadow: 
    inset 0 0 0 1px rgba(255,255,255,.06),
    inset 0 2px 3px rgba(255,255,255,.12),
    0 25px 50px rgba(0,0,0,.7);
  cursor: zoom-in;
}
.mat {
  display: block; overflow: hidden;
  border: 2px solid var(--gold);
  background: var(--mat);
  padding: clamp(8px, 1.8vh, 18px);
  box-shadow: inset 0 0 10px rgba(0,0,0,.15);
}
.wall-item img {
  display: block;
  height: var(--h); width: auto; max-width: 50vw;
  -webkit-user-drag: none;
}

/* --- ПОДВЕСЫ (ГВОЗДИ И ВЕРЕВОЧКИ) --- */
.hardware {
  position: absolute;
  left: 50%; transform: translateX(-50%);
  z-index: 0;
}
/* Обычный гвоздь */
.hardware.nail {
  top: -20px;
  width: 7px; height: 7px;
  background: #111; border-radius: 50%;
  box-shadow: 0 1px 2px rgba(255,255,255,0.2), inset 0 2px 3px rgba(0,0,0,1);
}
/* Веревочка (шнур натягивается от краев рамы к гвоздю) */
.hardware.string {
  top: 0;
  width: 50%;
  height: 55px;
}
.hardware.string::before { /* Гвоздь */
  content: ''; position: absolute;
  top: 0; left: 50%; transform: translateX(-50%);
  width: 7px; height: 7px;
  background: #111; border-radius: 50%;
  box-shadow: 0 1px 2px rgba(255,255,255,0.2), inset 0 2px 3px rgba(0,0,0,1);
}
.hardware.string::after { /* Сам шнур (нарисован градиентом как треугольник без низа) */
  content: ''; position: absolute;
  top: 4px; left: 0; right: 0; bottom: 0;
  background:
    linear-gradient(to bottom right, transparent 48%, rgba(255,255,255,0.25) 49%, rgba(255,255,255,0.25) 51%, transparent 52%) left / 50.5% 100% no-repeat,
    linear-gradient(to top right, transparent 48%, rgba(255,255,255,0.25) 49%, rgba(255,255,255,0.25) 51%, transparent 52%) right / 50.5% 100% no-repeat;
}

/* --- ТАБЛИЧКИ --- */
.plaque {
  position: relative; z-index: 2;
  margin: 16px 0 0;
  font-size: .78rem; color: var(--muted);
  text-align: center; max-width: 20vw; line-height: 1.4;
}

/* --- LIGHTBOX --- */
.lightbox{
  position: fixed; inset: 0; z-index: 50;
  background: rgba(0,0,0,0);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 5vh 5vw; visibility: hidden; opacity: 0;
  transition: background 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.4s linear;
}
.lightbox.is-open{
  background: rgba(0,0,0,0.88);
  visibility: visible; opacity: 1;
}
.lightbox img{
  max-width: 88vw; max-height: 80vh;
  object-fit: contain;
  box-shadow: 0 25px 70px rgba(0,0,0,.8);
  opacity: 0; transform: scale(.92);
  transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.lightbox.is-open img{ opacity: 1; transform: scale(1); }
.lightbox-caption{
  position: absolute; left: 50%; bottom: 3.5vh; transform: translateX(-50%);
  font-size: 1.05rem; color: var(--ink); text-align: center; opacity: 0;
  letter-spacing: 0.02em; pointer-events: none;
  transition: opacity 0.35s ease 0.1s;
}
.lightbox.is-open .lightbox-caption{ opacity: 1; }
.lightbox-close{
  position: absolute; top: 28px; right: 36px;
  background: none; border: none; color: var(--ink);
  font-size: 2.5rem; line-height: 1; cursor: pointer; opacity: 0;
  transform: scale(0.9);
  transition: opacity 0.3s ease, transform 0.3s ease, color 0.2s ease;
}
.lightbox.is-open .lightbox-close{ opacity: .75; transform: scale(1); }
.lightbox-close:hover{ opacity: 1; color: #fff; transform: scale(1.1); }





