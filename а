:root{
  --bg: #14100c;
  --ink: #efe6d6;
  --muted: rgba(239,230,214,0.6);
  --line: rgba(239,230,214,0.16);
  --wood-lo: #140d08;
  --wood-hi: #3e2a19;
  --gold: #a9895a;
  --mat: #ece2ce;

  --font-display: 'Playfair Display', Georgia, serif;
  --font-ui: 'PT Sans', -apple-system, sans-serif;
}

*{ box-sizing: border-box; }

html, body{
  margin: 0;
  height: 100%;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-ui);
  -webkit-font-smoothing: antialiased;
  overflow: hidden;
}

img{ max-width: none; display: block; }

.wall-texture{
  position: fixed;
  inset: 0;
  background-image:
    repeating-linear-gradient(115deg, rgba(255,255,255,.02) 0px, rgba(255,255,255,.02) 1px, transparent 1px, transparent 5px),
    repeating-linear-gradient(25deg, rgba(0,0,0,.05) 0px, rgba(0,0,0,.05) 1px, transparent 1px, transparent 7px);
  pointer-events: none;
  z-index: 0;
}
.grain{
  position: fixed;
  inset: 0;
  background-image: url('../images/grain.png');
  background-size: 160px 160px;
  opacity: 0.045;
  mix-blend-mode: overlay;
  pointer-events: none;
  z-index: 20;
}
body::before{
  content: '';
  position: fixed;
  inset: 0;
  background: radial-gradient(ellipse 80% 70% at 50% 46%, transparent 45%, rgba(0,0,0,.4) 100%);
  pointer-events: none;
  z-index: 4;
}

.lang-switch{
  position: fixed;
  top: 22px;
  left: 26px;
  z-index: 35;
  display: flex;
  gap: 8px;
}
.lang-btn{
  background: none;
  border: 1px solid var(--line);
  color: var(--muted);
  font-family: var(--font-ui);
  font-size: .8rem;
  letter-spacing: .02em;
  padding: 6px 13px;
  border-radius: 20px;
  cursor: pointer;
  transition: color .2s ease, border-color .2s ease;
}
.lang-btn.is-active{ color: var(--ink); border-color: var(--ink); }
.lang-btn:hover{ color: var(--ink); }

.social-bar{
  position: fixed;
  left: 50%;
  bottom: 22px;
  transform: translateX(-50%);
  z-index: 35;
  display: flex;
  gap: 18px;
}
.social-bar a{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  color: var(--ink);
  opacity: .78;
  transition: opacity .2s ease, transform .2s ease;
}
.social-bar a:hover{ opacity: 1; transform: translateY(-1px); }
.social-bar svg{ width: 100%; height: 100%; display: block; }

.identity{
  position: fixed;
  top: 34px;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 5;
  pointer-events: none;
}
.identity .name{
  font-family: var(--font-display);
  font-weight: 700;
  font-size: 1.7rem;
  margin: 0;
  letter-spacing: -0.01em;
}
.identity .line{
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1rem;
  color: var(--muted);
  margin: 8px 0 0;
}

.wall-track{
  position: fixed;
  left: 0;
  right: 0;
  top: 120px;
  bottom: 90px;
  display: flex;
  align-items: center;
  padding-inline: 12vw;
  overflow-x: auto;
  overflow-y: hidden;
  scrollbar-width: none;
  cursor: grab;
  z-index: 2;
}
.wall-track::-webkit-scrollbar{ display: none; }
.wall-track.is-grabbing{ cursor: grabbing; }

.wall-item{
  position: relative;
  flex: 0 0 auto;
  margin: 0 var(--mr, 40px) 0 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateY(var(--dy, 0px));
}

.spot{
  position: absolute;
  top: -52px;
  left: 50%;
  width: 78%;
  height: 80px;
  transform: translateX(-50%) scaleY(.4);
  transform-origin: top center;
  background: radial-gradient(ellipse at 50% 0%, rgba(255,232,185,.4) 0%, transparent 72%);
  filter: blur(7px);
  opacity: 0;
  transition: opacity .7s ease, transform .7s ease;
  pointer-events: none;
  z-index: 1;
}
.wall-item.in-view .spot{
  opacity: 1;
  transform: translateX(-50%) scaleY(1);
}

.frame{
  position: relative;
  z-index: 2;
  border-radius: 3px;
  padding: 15px;
  background:
    linear-gradient(150deg, var(--wood-hi) 0%, var(--wood-lo) 55%, #0c0805 100%);
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.08),
    inset 0 2px 3px rgba(255,255,255,.16),
    inset 0 -5px 10px rgba(0,0,0,.65),
    0 30px 60px rgba(0,0,0,.6);
}

.mat{
  display: block;
  overflow: hidden;
  border-radius: 1px;
  border: 3px solid var(--gold);
  background: var(--mat);
  padding: clamp(8px, 2.2vh, 22px);
  box-shadow: inset 0 0 12px rgba(0,0,0,.12);
}

.wall-item img{
  display: block;
  border-radius: 1px;
  height: var(--h);
  width: auto;
  max-width: 56vw;
  max-height: var(--h);
  cursor: zoom-in;
  user-select: none;
  -webkit-user-drag: none;
}

.plaque{
  position: relative;
  z-index: 2;
  margin: 16px 0 0;
  font-family: var(--font-ui);
  font-size: .78rem;
  color: var(--muted);
  text-align: center;
  max-width: 22vw;
  line-height: 1.4;
}

@media (prefers-reduced-motion: reduce){
  .wall-item, .spot{ transition: none; }
}

.lightbox{
  position: fixed; inset: 0; z-index: 50;
  background: rgba(8,7,6,0);
  display: flex; align-items: center; justify-content: center;
  padding: 6vh 6vw;
  visibility: hidden;
  transition: background .45s ease, visibility 0s linear .45s;
}
.lightbox.is-open{
  background: rgba(8,7,6,0.9);
  visibility: visible;
  transition: background .45s ease, visibility 0s linear 0s;
}

.lightbox img{
  max-width: 82vw;
  max-height: 82svh;
  width: auto;
  height: auto;
  box-shadow: 0 20px 60px rgba(0,0,0,.5);
  opacity: 0;
  transform: scale(.9);
  transition: opacity .4s cubic-bezier(.22,.8,.25,1), transform .4s cubic-bezier(.22,.8,.25,1);
}
.lightbox.is-open img{ opacity: 1; transform: scale(1); }

.lightbox-caption{
  position: absolute;
  left: 50%;
  bottom: 7vh;
  transform: translateX(-50%);
  margin: 0;
  padding: 8px 20px;
  font-size: 1rem;
  color: var(--ink);
  text-align: center;
  max-width: 70vw;
  opacity: 0;
  transition: opacity .4s ease .1s;
}
.lightbox.is-open .lightbox-caption{ opacity: 1; }

.lightbox-close{
  position: absolute;
  top: 26px;
  right: 30px;
  background: none;
  border: none;
  color: var(--ink);
  font-size: 2.1rem;
  line-height: 1;
  cursor: pointer;
  font-family: var(--font-ui);
  opacity: 0;
  transition: opacity .3s ease;
}
.lightbox.is-open .lightbox-close{ opacity: .85; }
.lightbox-close:hover{ opacity: 1; }

a:focus-visible, button:focus-visible{
  outline: 1px solid var(--ink);
  outline-offset: 3px;
}



